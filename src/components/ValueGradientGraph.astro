---
import "./charts/ScientificChart.css";

// Layout: states and transition blocks on the bottom row, actions and policy blocks
// in the middle, rewards on top. Every connector is horizontal or vertical with
// rounded elbows, and one trunk per state forks into the policy and the reward.
const X0 = 58;
const DX = 232;
const R = 24; // variable radius
const P = 15; // half-size of a function block
const CORNER = 14;
const GAP = 3; // space between an arrow tip and its node
const Y = { reward: 40, action: 148, state: 262 };
const steps = [0, 1, 2];
const id = `trajectory-graph-${crypto.randomUUID()}`;

type Point = [number, number];

/** Polyline with rounded corners, ending GAP before its last point. */
function rounded(points: Point[]) {
  const pts = points.map(([x, y]) => [x, y] as Point);
  const [end, before] = [pts.at(-1)!, pts.at(-2)!];
  end[0] -= Math.sign(end[0] - before[0]) * GAP;
  end[1] -= Math.sign(end[1] - before[1]) * GAP;
  let d = `M ${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const [p, c, n] = [pts[i - 1], pts[i], pts[i + 1]];
    const into = Math.min(CORNER, Math.hypot(c[0] - p[0], c[1] - p[1]) / 2);
    const out = Math.min(CORNER, Math.hypot(n[0] - c[0], n[1] - c[1]) / 2);
    const a: Point = [
      c[0] - Math.sign(c[0] - p[0]) * into,
      c[1] - Math.sign(c[1] - p[1]) * into,
    ];
    const b: Point = [
      c[0] + Math.sign(n[0] - c[0]) * out,
      c[1] + Math.sign(n[1] - c[1]) * out,
    ];
    d += ` L ${a[0]} ${a[1]} Q ${c[0]} ${c[1]} ${b[0]} ${b[1]}`;
  }
  return `${d} L ${end[0]} ${end[1]}`;
}

const layout = steps.map((step) => {
  const x = X0 + step * DX;
  const xa = x + DX / 2;
  const xm = x + DX / 4 + 4;
  const nodes = {
    state: [x, Y.state] as Point,
    action: [xa, Y.action] as Point,
    reward: [xa, Y.reward] as Point,
    policy: [xm, Y.action] as Point,
    transition: [xa, Y.state] as Point,
  };
  // Forward points of each edge; the gradient path reverses them. Branch numbers
  // match GRADIENT_BRANCH in gradient-flow.mjs.
  const raw: { branch: number; points: Point[] }[] = [
    {
      branch: 0,
      points: [
        [xa + P, Y.state],
        [x + DX - R, Y.state],
      ],
    }, // transition -> next state
    {
      branch: 1,
      points: [
        [x + R, Y.state],
        [xa - P, Y.state],
      ],
    }, // state -> transition
    {
      branch: 2,
      points: [
        [xa, Y.action + R],
        [xa, Y.state - P],
      ],
    }, // action -> transition
    {
      branch: 3,
      points: [
        [xa, Y.action - R],
        [xa, Y.reward + R],
      ],
    }, // action -> reward
    {
      branch: 4,
      points: [
        [x, Y.state - R],
        [x, Y.reward],
        [xa - R, Y.reward],
      ],
    }, // state -> reward
    {
      branch: 5,
      points: [
        [xm + P, Y.action],
        [xa - R, Y.action],
      ],
    }, // policy -> action
    {
      branch: 6,
      points: [
        [x, Y.state - R],
        [x, Y.action],
        [xm - P, Y.action],
      ],
    }, // state -> policy
  ];
  const edges = raw.map((edge) => ({
    ...edge,
    forward: rounded(edge.points),
    gradient: rounded([...edge.points].reverse()),
  }));
  return { step, nodes, edges };
});
const last: Point = [X0 + 3 * DX, Y.state];
const width = last[0] + 80;
const height = 296;
// The chain continues past the last state: rightward and up its trunk.
const ends: Record<string, Point> = {
  stateRight: [last[0] + R, Y.state],
  edge: [width - 6, Y.state],
  stateTop: [last[0], Y.state - R],
  above: [last[0], Y.action + 6],
};
const continuation = {
  right: rounded([ends.stateRight, ends.edge]),
  up: rounded([ends.stateTop, ends.above]),
  rightGradient: rounded([ends.edge, ends.stateRight]),
  upGradient: rounded([ends.above, ends.stateTop]),
};
const sub = (step: number) => (step > 0 ? `+${step}` : "");
---

<figure
  class="scientific-chart not-prose trajectory-graph"
  style="--figure-font-scale: 1.2"
  data-gradient="false"
>
  <div class="chart-layer-controls graph-controls">
    <label>
      <input
        type="checkbox"
        role="switch"
        data-gradient-toggle
        aria-controls={`${id}-svg`}
      />
      Compute gradient
    </label>
  </div>
  <div
    class="graph-scroll"
    tabindex="0"
    role="region"
    aria-label="Trajectory computation graph. Scroll horizontally to explore all steps."
  >
    <svg
      id={`${id}-svg`}
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-labelledby={`${id}-title ${id}-description`}
    >
      <title id={`${id}-title`}>Computational graph of a trajectory</title>
      <desc id={`${id}-description`}>
        Three steps of a trajectory from state s t to state s t+3, continuing to
        the right with dashed lines. Along the bottom row, each state and the
        action above it feed a square transition block f, which produces the
        next state. From each state, one line rises and forks: one branch enters
        a square policy block mu theta, which produces the action, and the other
        continues up to the reward. Each action also feeds its reward. The
        gradient switch animates return derivatives backward along the same
        lines, starting from state s t+3, so that the derivatives from the
        reward and from the policy merge at the fork on their way back into each
        state. Reduced-motion mode shows the reversed lines without animation.
      </desc>
      <defs>
        <marker
          id={`${id}-tip`}
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="7.5"
          markerHeight="7.5"
          markerUnits="userSpaceOnUse"
          orient="auto"
        >
          <path d="M0.5,0.8 L9.5,5 L0.5,9.2 L2.6,5 Z" class="tip"></path>
        </marker>
        <marker
          id={`${id}-gradient-tip`}
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="8.5"
          markerHeight="8.5"
          markerUnits="userSpaceOnUse"
          orient="auto"
        >
          <path d="M0.5,0.8 L9.5,5 L0.5,9.2 L2.6,5 Z" class="gradient-tip"
          ></path>
        </marker>
      </defs>

      <g class="edges forward-edges" marker-end={`url(#${id}-tip)`}>
        {
          layout.flatMap(({ edges }) =>
            edges.map(({ forward }) => <path d={forward} />),
          )
        }
        <path class="continuation" d={continuation.right}></path>
        <path class="continuation" d={continuation.up}></path>
      </g>
      <g
        class="edges gradient-edges"
        marker-end={`url(#${id}-gradient-tip)`}
        aria-hidden="true"
      >
        <path
          class="continuation"
          data-gradient-context
          d={continuation.rightGradient}></path>
        <path
          class="continuation"
          data-gradient-context
          d={continuation.upGradient}></path>
        {
          layout.flatMap(({ step, edges }) =>
            edges.map(({ branch, gradient }) => (
              <path
                d={gradient}
                data-gradient-step={step}
                data-gradient-branch={branch}
              />
            )),
          )
        }
      </g>

      {
        layout.map(({ step, nodes }) => (
          <>
            <g
              class="node reward"
              data-node={`reward-${step}`}
              transform={`translate(${nodes.reward.join(",")})`}
            >
              <circle r={R} />
              <text y="6">
                r
                <tspan class="subscript" dy="6">
                  <tspan class="variable">t</tspan>
                  {sub(step)}
                </tspan>
              </text>
            </g>
            <g
              class="node action"
              data-node={`action-${step}`}
              transform={`translate(${nodes.action.join(",")})`}
            >
              <circle r={R} />
              <text y="6">
                a
                <tspan class="subscript" dy="6">
                  <tspan class="variable">t</tspan>
                  {sub(step)}
                </tspan>
              </text>
            </g>
            <g
              class="node state"
              data-node={`state-${step}`}
              transform={`translate(${nodes.state.join(",")})`}
            >
              <circle r={R} />
              <text y="6">
                s
                <tspan class="subscript" dy="6">
                  <tspan class="variable">t</tspan>
                  {sub(step)}
                </tspan>
              </text>
            </g>
            <g
              class="node policy block"
              data-node={`policy-${step}`}
              transform={`translate(${nodes.policy.join(",")})`}
            >
              <rect x={-P} y={-P} width={2 * P} height={2 * P} rx="5" />
              <text y="5">
                μ
                <tspan class="subscript" dy="3">
                  θ
                </tspan>
              </text>
            </g>
            <g
              class="node block transition"
              data-node={`transition-${step}`}
              transform={`translate(${nodes.transition.join(",")})`}
            >
              <rect x={-P} y={-P} width={2 * P} height={2 * P} rx="5" />
              <text y="5">f</text>
            </g>
          </>
        ))
      }
      <g
        class="node state"
        data-node="state-3"
        transform={`translate(${last.join(",")})`}
      >
        <circle r={R}></circle>
        <text y="6"
          >s<tspan class="subscript" dy="6"
            ><tspan class="variable">t</tspan>+3</tspan
          ></text
        >
      </g>
    </svg>
  </div>
  <div class="scroll-hint" aria-hidden="true">
    Scroll horizontally to follow the trajectory →
  </div>
  <figcaption class="chart-caption">
    <strong>Figure 2.</strong>{" "}Computational graph of a trajectory. Each
    state passes through the policy <i>μ</i><sub>θ</sub>{" "}to give the action,
    and the transition{" "}<i>f</i>{" "}combines the state and the action into
    the next state. Each reward depends on the state and the action. Switch on{
      " "
    }<strong>Compute gradient</strong>{" "}to follow the return derivatives
    backward through the graph.
  </figcaption>
</figure>

<script>
  import {
    createGradientFlowTimeline,
    gradientFlowProgress,
  } from "@/lib/value-gradients/gradient-flow.mjs";

  document
    .querySelectorAll<HTMLElement>(".trajectory-graph")
    .forEach((figure) => {
      const toggle = figure.querySelector<HTMLInputElement>(
        "[data-gradient-toggle]",
      );
      if (!toggle) return;
      const timeline = createGradientFlowTimeline(3);
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      const paths = timeline.edges
        .map((edge) => ({
          ...edge,
          element: figure.querySelector<SVGPathElement>(
            `[data-gradient-step="${edge.step}"][data-gradient-branch="${edge.branch}"]`,
          )!,
        }))
        .map((edge) => ({ ...edge, length: edge.element.getTotalLength() }));
      const nodes = timeline.nodes.map((node) => ({
        ...node,
        element: figure.querySelector<SVGGElement>(
          `[data-node="${node.key}"]`,
        )!,
      }));
      let frame = 0;
      let elapsed = 0;
      let lastTime: number | undefined;
      let visible = false;
      const clear = () => {
        paths.forEach(({ element }) => {
          element.style.removeProperty("stroke-dasharray");
          element.style.removeProperty("stroke-dashoffset");
          element.style.removeProperty("marker-end");
          element.style.removeProperty("opacity");
        });
        nodes.forEach(({ element }) => {
          delete element.dataset.lit;
        });
      };
      const draw = (time: number) => {
        for (const { element, length, start, duration } of paths) {
          const progress = gradientFlowProgress(time, start, duration);
          element.style.opacity = progress > 0 ? "1" : "0";
          element.style.strokeDasharray = `${length} ${length}`;
          element.style.strokeDashoffset = String(length * (1 - progress));
          // Reveal the arrowhead only when the derivative reaches its destination.
          if (progress === 1) element.style.removeProperty("marker-end");
          else element.style.markerEnd = "none";
        }
        nodes.forEach(({ element, at }) => {
          element.dataset.lit = String(time >= at);
        });
      };
      const shouldRun = () =>
        toggle.checked && !reducedMotion.matches && visible && !document.hidden;
      const tick = (now: number) => {
        frame = 0;
        if (!shouldRun()) return;
        if (lastTime !== undefined) elapsed += now - lastTime;
        lastTime = now;
        draw(elapsed % timeline.duration);
        frame = requestAnimationFrame(tick);
      };
      const sync = () => {
        if (frame) cancelAnimationFrame(frame);
        frame = 0;
        lastTime = undefined;
        if (shouldRun()) frame = requestAnimationFrame(tick);
      };
      const update = () => {
        elapsed = 0;
        figure.dataset.gradient = String(toggle.checked);
        figure.dataset.motion =
          toggle.checked && !reducedMotion.matches ? "running" : "static";
        clear();
        if (toggle.checked && !reducedMotion.matches) draw(0);
        sync();
      };
      toggle.addEventListener("change", update);
      reducedMotion.addEventListener("change", update);
      document.addEventListener("visibilitychange", sync);
      const observer = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        sync();
      });
      observer.observe(figure);
      update();
    });
</script>

<style>
  .trajectory-graph {
    container-type: inline-size;
    /* Blues accent for decisions; neutral colors, font, width, and caption come from the shared figure style. */
    --graph-accent: light-dark(#2171b5, #6baed6);
    --graph-gradient: light-dark(#d94801, #fd8d3c);
  }
  .graph-scroll {
    overflow-x: auto;
  }
  .graph-scroll:focus-visible {
    outline: 2px solid var(--chart-focus);
    outline-offset: -2px;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 600px;
  }
  .edges {
    fill: none;
    stroke-width: 1.85;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .forward-edges {
    stroke: var(--chart-baseline);
  }
  .tip {
    fill: var(--chart-baseline);
  }
  .gradient-tip {
    fill: var(--graph-gradient);
  }
  .continuation {
    stroke-dasharray: 2 5;
  }
  .forward-edges .continuation {
    opacity: 0.75;
  }
  .node circle,
  .node rect {
    fill: var(--chart-canvas);
    stroke: var(--chart-baseline);
    stroke-width: 1.35;
  }
  .node text {
    fill: var(--chart-text);
    text-anchor: middle;
    font-family: KaTeX_Math, "Times New Roman", serif;
    font-size: calc(16.5px * var(--figure-font-scale));
  }
  .subscript {
    font-family: KaTeX_Main, "Times New Roman", serif;
    font-size: 64%;
  }
  .subscript .variable {
    font-family: KaTeX_Math, "Times New Roman", serif;
  }
  .block text {
    font-size: calc(13px * var(--figure-font-scale));
  }
  .action circle {
    fill: color-mix(in srgb, var(--graph-accent) 13%, var(--chart-canvas));
    stroke: var(--graph-accent);
  }
  .action text,
  .policy text {
    fill: var(--graph-accent);
  }
  .policy rect {
    stroke: var(--graph-accent);
  }
  .reward circle {
    fill: color-mix(in srgb, var(--chart-baseline) 9%, var(--chart-canvas));
  }
  .graph-controls input[role="switch"] {
    color: var(--graph-gradient);
  }
  .graph-controls {
    justify-content: space-between;
    margin-top: 0;
    margin-bottom: 0.75rem;
  }
  /* The gradient runs along the forward lines, which fade to a faint guide. */
  .gradient-edges {
    display: none;
    stroke: var(--graph-gradient);
    stroke-width: 2.7;
  }
  [data-gradient="true"] .gradient-edges {
    display: inline;
  }
  [data-gradient="true"] .forward-edges {
    opacity: 0.22;
  }
  .gradient-edges [data-gradient-context] {
    opacity: 0.45;
  }
  /* Reduced motion shows the finished pass, with every node lit. */
  [data-gradient="true"][data-motion="static"] .node circle,
  [data-gradient="true"][data-motion="static"] .node rect,
  .node[data-lit="true"] circle,
  .node[data-lit="true"] rect {
    stroke: var(--graph-gradient);
    fill: color-mix(in srgb, var(--graph-gradient) 10%, var(--chart-canvas));
  }
  [data-gradient="true"][data-motion="static"] .node text,
  .node[data-lit="true"] text {
    fill: var(--graph-gradient);
  }
  .scroll-hint {
    display: none;
    margin-top: 0.5rem;
    color: var(--chart-muted);
    font-size: 0.8rem;
  }
  @container (max-width: 600px) {
    .scroll-hint {
      display: block;
    }
  }
</style>
