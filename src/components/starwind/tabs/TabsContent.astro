---
import type { HTMLAttributes } from "astro/types";
import { tabsContent } from "./variants";

interface Props extends Omit<
  HTMLAttributes<"div">,
  "id" | "role" | "tabindex" | "hidden"
> {
  value: string;
}

const { value, class: className, ...rest } = Astro.props;
---

<div
  class={tabsContent({ class: className })}
  data-slot="tabs-content"
  data-tabs-content
  data-value={value}
  data-state="inactive"
  role="tabpanel"
  tabindex="0"
  hidden
  {...rest}
>
  <slot />
</div>
