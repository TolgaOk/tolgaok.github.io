---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import BaseLayout from "@/layouts/BaseLayout.astro";
import portrait from "@/assets/portrait.jpg";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Preferred section order; any other kind found in posts is appended.
const kindOrder = ["research", "software"];
const kinds = [
  ...kindOrder.filter((kind) => posts.some((post) => post.data.kind === kind)),
  ...new Set(
    posts.map((post) => post.data.kind).filter((kind) => !kindOrder.includes(kind)),
  ),
];

const publications = [
  {
    title: "Limiting-Kernel Q(λ): Bridging Short and Long Horizons",
    url: "https://arxiv.org/abs/2609.27741",
    venue: "arXiv 2026",
    status: "2609.27741",
    authors: "Tolga Ok, Arman Sharifi Kolarijani, Peyman Mohajerin Esfahani, and Mohamad Amin Sharifi Kolarijani",
    links: [
      { name: "Paper", url: "https://arxiv.org/pdf/2609.27741" },
    ],
  },
  {
    title: "Offline Reinforcement Learning via Inverse Optimization",
    url: "https://openreview.net/forum?id=lSj2gXoeCy",
    venue: "TMLR 2026",
    authors: "Ioannis Dimanidis, Tolga Ok, and Peyman Mohajerin Esfahani",
    links: [
      { name: "Paper", url: "https://openreview.net/pdf?id=lSj2gXoeCy" },
      { name: "Code", url: "https://github.com/TolgaOk/offlineRLviaIO" },
    ],
  },
  {
    title: "Control and Reinforcement Learning through the Lens of Optimization: An Algorithmic Perspective",
    url: "https://arxiv.org/pdf/2512.07377",
    venue: "arXiv 2025",
    status: "2512.07377 · under review",
    authors: "Tolga Ok, Arman Sharifi Kolarijani, Mohamad Amin Sharifi Kolarijani, and Peyman Mohajerin Esfahani",
    links: [
      { name: "Paper", url: "https://arxiv.org/pdf/2512.07377" },
    ],
  },
  {
    title: "Rank-One Modified Value Iteration",
    url: "https://proceedings.mlr.press/v267/kolarijani25a.html",
    venue: "ICML 2025",
    authors: "Arman Sharifi Kolarijani, Tolga Ok, Peyman Mohajerin Esfahani, and Mohamad Amin Sharifi Kolarijani",
    links: [
      { name: "Paper", url: "https://raw.githubusercontent.com/mlresearch/v267/main/assets/kolarijani25a/kolarijani25a.pdf" },
      { name: "Code", url: "https://github.com/TolgaOk/r1vi-paper" },
    ],
  },
  {
    title: "Scalable Kernel Inverse Optimization",
    url: "https://proceedings.neurips.cc/paper_files/paper/2024/hash/b3f269d610fc0a0972bd4c2f4905165a-Abstract-Conference.html",
    venue: "NeurIPS 2024",
    authors: "Youyuan Long, Tolga Ok, Pedro Zattoni Scroccaro, and Peyman Mohajerin Esfahani",
    links: [
      { name: "Paper", url: "https://proceedings.neurips.cc/paper_files/paper/2024/file/b3f269d610fc0a0972bd4c2f4905165a-Paper-Conference.pdf" },
      { name: "Code", url: "https://github.com/Longyouyuan/Scalable-Kernel-Inverse-Optimization" },
    ],
  },
  {
    title: "Core Skill Decomposition of Complex Wargames with Reinforcement Learning",
    url: "https://arc.aiaa.org/doi/abs/10.2514/6.2022-2084",
    venue: "AIAA SciTech 2022",
    authors: "Kubilay Kağan Kömürcü, Batuhan İnce, Tolga Ok, Emircan Kılıçkaya, and Nazım Kemal Üre",
    links: [
      { name: "Paper", url: "https://doi.org/10.2514/6.2022-2084" },
    ],
  },
];

const links = [
  { name: "GitHub", url: "https://github.com/TolgaOk", icon: "ri:github-line" },
  {
    name: "Scholar",
    url: "https://scholar.google.com/citations?user=fUZamLEAAAAJ",
    icon: "academicons:google-scholar",
  },
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/tolga-ok-81874b257/",
    icon: "ri:linkedin-fill",
  },
  { name: "Email", url: "mailto:T.Ok@tudelft.nl", icon: "ri:mail-line" },
  // TODO: add CV link
];

const prefix = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "short" });
---

<BaseLayout
  title="Tolga Ok"
  description="Reinforcement learning, optimization, and their applications in robotics."
>
  <div
    class="flex flex-col-reverse items-start gap-x-10 gap-y-6 sm:flex-row sm:items-center"
  >
    <div>
      <h1>Tolga Ok</h1>

      <p>
        My goal is to make reinforcement learning work out of the box.
        Towards this goal, I develop mathematically grounded methods and insights, and build tools to facilitate RL experiments.
        I’m currently a PhD candidate at the <a
          href="https://www.tudelft.nl/me/over/afdelingen/delft-center-for-systems-and-control"
          >Delft Center for Systems and Control</a
        > at <a href="https://www.tudelft.nl/">TU Delft</a>, supervised by <a href="https://mohajerinesfahani.github.io/"
          >Peyman Mohajerin Esfahani</a
        > and <a href="https://sites.google.com/view/aminkolarijani/home"
          >Mohamad Amin Sharifi Kolarijani</a
        >.
      </p>
    </div>
    <Image
      src={portrait}
      alt="Portrait of Tolga Ok"
      width={320}
      class="not-prose aspect-[4/5] w-40 shrink-0 rounded-2xl object-cover sm:w-44"
    />
  </div>

  <div class="not-prose flex flex-row flex-wrap gap-2">
    {
      links.map((link) => (
        <a
          href={link.url}
          class="flex flex-row items-center gap-2 rounded-full bg-zinc-800 px-5 py-2 text-lg text-white hover:bg-black hover:no-underline dark:bg-zinc-200 dark:text-zinc-900 dark:hover:bg-zinc-50"
        >
          {link.icon && <Icon name={link.icon} />}
          <span>{link.name}</span>
        </a>
      ))
    }
  </div>

  {
    kinds.map((kind) => (
      <section>
        <h2 id={kind}>{kind.charAt(0).toUpperCase() + kind.slice(1)}</h2>
        <ul class="list-none pl-0">
          {posts
            .filter((post) => post.data.kind === kind)
            .map((post) => (
              <li class="flex flex-row items-center gap-4 pl-0">
                {post.data.image ? (
                  <a
                    href={`${prefix}${post.data.kind}/${post.id}/`}
                    class="not-prose shrink-0"
                  >
                    <Image
                      src={post.data.image}
                      alt={post.data.title}
                      width={256}
                      class="size-16 rounded-xl object-cover"
                    />
                  </a>
                ) : (
                  <div class="size-16 shrink-0 rounded-xl bg-zinc-100 dark:bg-zinc-800" />
                )}
                <div>
                  <a href={`${prefix}${post.data.kind}/${post.id}/`}>
                    {post.data.title}
                  </a>
                  <span class="text-base text-zinc-500 dark:text-zinc-400">
                    {" · "}
                    {formatDate(post.data.date)}
                  </span>
                  {post.data.description && <> · {post.data.description}</>}
                </div>
              </li>
            ))}
        </ul>
      </section>
    ))
  }

  <section>
    <h2 id="publications">Publications</h2>
    <ul>
      {
        publications.map((publication) => (
          <li>
            {publication.title}
            <span class="text-base text-zinc-500 dark:text-zinc-400">
              {" · "}
              <span class="font-bold">{publication.venue}</span>
              {publication.status && <> · {publication.status}</>}
            </span>
            {publication.links.map((link) => (
              <a class="ms-2 inline-block text-base" href={link.url}>
                {link.name}
              </a>
            ))}
            <div class="text-base text-zinc-500 dark:text-zinc-400">
              {publication.authors}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
